# mac-game-streaming config. Every script sources this (as shell), so use shell syntax and quote paths.
# Copy it to ~/.config/mac-game-streaming/config.env, or point GS_CONFIG at another file.
# GS_HOME (this repo's root) is set before this file is read.

# The free Wine engine: the Libraries folder of a dappermint/winecx-gptk runtime (it holds Wine/, DXMT/ and DXVK/).
GS_RUNTIME="$HOME/Library/Application Support/mac-game-streaming/runtime/winecx-gptk-4.8.1/Libraries"

# The Wine prefix ("bottle") the game is installed in.
WINEPREFIX="$HOME/Library/Application Support/mac-game-streaming/bottles/Mass Effect Legendary Edition"

# Sunshine.app built from the gamepad fork (see the README).
SUNSHINE_APP="$HOME/src/sunshine-macos-gamepads/build/Sunshine.app"

# Optional: what `gs quit` and `gs down` run to close the game. Without it they stop the bottle with
# `wineserver -k`, which can cut off a launcher's cloud-save upload.
GS_QUIT="$GS_HOME/examples/mass-effect-le/me-quit.sh"
# Optional: the log `gs quit` shows the end of.
GS_QUIT_LOG="${TMPDIR:-/tmp}/me-quit.log"

# Optional: extra logs `gs logs` follows besides Sunshine's, separated by spaces (no spaces inside a path).
GS_LOGS="${TMPDIR:-/tmp}/me-launch.log ${TMPDIR:-/tmp}/me-quit.log"
